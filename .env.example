# Copy to .env and fill in. NEVER commit .env — it holds a Vault token.
# Full reference: docs/en/pipeline/relay-container.md

CIC_RELAY_PORT=8080

# Must be the SAME host path the builder container mounts, or the builder
# cannot see the clone the relay just made.
CIC_BUILD_DIR=./build
CIC_AUDIT_DIR=./relay-audit
CIC_SECRETS_DIR=./relay-secrets

# The container the pipeline runs `make <target>` in.
CIC_BUILDER_CONTAINER=cic-py-builder

# Vault normally runs on the host; a bridge network cannot reach it as 127.0.0.1.
VAULT_ADDR=https://host.docker.internal:8200
VAULT_TOKEN=
VAULT_CACERT=/run/secrets/relay/vault-ca.crt
CIC_VAULT_MOUNT=transit
# The token must be authorised for THIS key — a valid token is not enough.
CIC_VAULT_KEY=

CIC_TRUST_MODE=dev
