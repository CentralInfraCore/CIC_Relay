---
# .yamllint configuration
# See https://yamllint.readthedocs.io/en/stable/configuration.html

extends: default

rules:
  # Increase the line-length limit to a more reasonable value for modern displays.
  line-length:
    max: 140
    level: warning  # Set to 'warning' instead of 'error' to be less strict.

  # GitHub Actions uses 'on' as a valid key, which is a truthy value.
  truthy:
    allowed-values: ['true', 'false', 'on']

# Override rules for specific file paths
file-rules:
  .github/workflows/*.yml:
    document-start:
      present: false  # GitHub Actions workflows don't require the document start marker.

ignore: |
  /p_venv/
  /source/
  /.mcp_data/
  # KB companion YAMLs are machine-generated beside every source file (module:/
  # package: + objects:). They are data, not hand-authored config — don't lint them.
  /cmd/
  /core/
  /pkg/
  /docs/
  /tools/
  /tests/
  # Generated schema / data / IaC YAML at the repo root.
  *.schema.yaml
  *.meta.yaml
  /LICENSE.yaml
  /README.yaml
  /project.yaml
  /feature-list.yaml
  /postgresql-*.yaml
  # Non-CI content: planning docs, PKI data assets, and POC examples are data,
  # not build/operational config. (NOTE: ai/PROMPTMAP.yaml has genuine duplicate
  # keys — tracked separately, not a yamllint-gate concern.)
  /ai/
  /embedded/
  /examples/
