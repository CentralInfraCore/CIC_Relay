# Temp/exported files
git_logst_secret.txt
gitlog.txt
merged_graph_data_cleaned.ndjson

# Release artifacts — generated, do not commit
dist/

# MCP knowledge base — generated, do not commit
.mcp_data/
/kb_data/

# Embedded PKI dev keys — do not commit new key material here
# (existing keys are test-only and grandfathered in)
embedded/pki/*.key
# Production PKI assets: placeholder is committed; make fetch-pki overwrites with real cert.
/.idea/
/.pip-cache/
/p_venv/
# Rust build output (one target/ for the whole workspace). Cargo.lock IS committed.
/target/
# cargo-mutants working dir (mutation testing output) — regenerated, never commit.
/mutants.out/
# Accidental self-referential symlink emitted by the KB companion-YAML generator
# (source -> .). It sends every recursive tool into infinite recursion; never commit it.
/source
/*/*/*/__pycache__/
/*/*/__pycache__/
/*/__pycache__/
/.coverage
