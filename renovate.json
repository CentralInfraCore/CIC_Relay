{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "pip-compile": {
    "enabled": true
  },
  "rebaseWhen": "behind-base-branch",
  "postUpgradeTasks": {
    "commands": ["scripts/gen_manifest.sh . MANIFEST.sha256"],
    "fileFilters": ["MANIFEST.sha256"],
    "executionMode": "branch"
  },
  "packageRules": [
    {
      "matchManagers": ["pip-compile"],
      "groupName": "python dependencies"
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["direct"],
      "groupName": "Go direct dependencies"
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "groupName": "Go indirect dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["docker-compose"],
      "groupName": "Docker images"
    },
    {
      "matchManagers": ["cargo"],
      "matchDepNames": ["vault-client-rs", "vault-client-rs-test"],
      "groupName": "vault-client-rs fork"
    }
  ]
}