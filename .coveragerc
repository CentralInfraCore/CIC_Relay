# Coverage config for the Python compiler-infrastructure test suite (tests/).
# pytest.ini drives --cov=tools; this file scopes what counts as measured source.
[run]
branch = False
omit =
    # Test files are not production source — counting them as source (they were
    # showing up at 0%) understated real coverage. Exclude them from measurement.
    tools/test_*.py
    tests/*
    */conftest.py

# NOTE: tools/go_ast_extract.py is intentionally NOT omitted. It is genuinely
# uncovered by the tests/ suite (its tests live in the currently-unwired
# tools/test_go_ast_extract.py). Leaving it measured keeps that gap visible and
# is the main lever to ratchet cov-fail-under upward once those tests are wired in.

[report]
show_missing = True
